# 複製本檔為 .env 後填入，.env 已被 .gitignore 排除，不會進版控。
#
# 目前支援的 provider: gemini / openai / anthropic / none
# 設為 none（或整個不設定）時，系統會自動降級為「僅規則層」模式，仍可完整執行。
LLM_PROVIDER=gemini

# Google AI Studio 免費金鑰：https://aistudio.google.com -> Get API key
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# 若改用 OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# 若改用 Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
